# Supabase project settings → API. These two values are public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Canonical website URL. Used for auth email redirects and mutation origin checks.
APP_URL=http://localhost:3000
# Server-only values. NEVER prefix these with NEXT_PUBLIC_.
MODEL_API_URL=http://127.0.0.1:8000
MODEL_API_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
